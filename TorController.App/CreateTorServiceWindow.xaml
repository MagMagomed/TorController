<Window x:Class="TorController.App.CreateTorServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать службу Tor"
        Height="760"
        Width="760"
        MinHeight="620"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Параметры новой службы Tor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Системное имя службы" VerticalAlignment="Center" Margin="0,4" />
                <TextBox x:Name="ServiceNameTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" Margin="4"
                         ToolTip="Что: уникальное системное имя службы Windows. Зачем: по нему Windows идентифицирует службу при управлении и запуске. Ожидается: буквы, цифры, точка, дефис или подчёркивание. Пример: TorNew." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Отображаемое имя" VerticalAlignment="Center" Margin="0,4" />
                <TextBox x:Name="DisplayNameTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="4"
                         ToolTip="Что: понятное название службы в Windows. Зачем: помогает отличать службу в списке служб и интерфейсе. Ожидается: любое непустое название. Пример: Tor New Service." />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Путь к tor.exe" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox x:Name="TorExecutableComboBox" Grid.Row="3" Grid.Column="1"
                          ItemsSource="{Binding SuggestedTorExecutablePaths}"
                          IsEditable="True"
                          Text="{Binding TorExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="4"
                          ToolTip="Что: исполняемый файл Tor, который запустит службу. Зачем: служба будет использовать именно эту версию Tor. Ожидается: абсолютный путь к существующему файлу tor.exe. Пример: C:\Tor\tor.exe." />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Новый каталог данных" VerticalAlignment="Center" Margin="0,4" />
                <TextBox x:Name="DataDirectoryTextBox" Grid.Row="4" Grid.Column="1" Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="4"
                         ToolTip="Что: отдельная папка данных новой службы. Зачем: изолирует её состояние и файлы от других служб Tor. Ожидается: абсолютный путь к ещё не созданному каталогу. Пример: C:\Tor\Instances\TorNew." />
                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="После проверки конфигурации Windows запросит подтверждение UAC для регистрации. Служба останется остановленной." TextWrapping="Wrap" Foreground="DimGray" Margin="4,6" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Тип запуска" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox x:Name="StartingTypeComboBox" Grid.Row="6" Grid.Column="1" ItemsSource="{Binding StartingTypes}" SelectedItem="{Binding StartingType}" Margin="4"
                          ToolTip="Что: когда Windows запускает службу. Зачем: определяет, будет ли Tor запускаться вместе с Windows или только по запросу. Ожидается: Automatic, Automatic (Delayed Start), Manual или Disabled. Пример: Manual — запуск только вручную." />
                <TextBlock Grid.Row="7" Grid.Column="0" Text="SOCKS-порты/адреса" VerticalAlignment="Center" Margin="0,4" />
                <TextBox x:Name="SocksPortsTextBox" Grid.Row="7" Grid.Column="1" Text="{Binding SocksPortsText, UpdateSourceTrigger=PropertyChanged}" Margin="4"
                         ToolTip="Что: SOCKS-порты, через которые приложения подключаются к Tor. Зачем: задаёт точки подключения приложений к этой службе Tor. Ожидается: номера портов или адрес:порт, несколько значений разделяйте запятой. Пример: 9050, 127.0.0.1:9060." />
                <CheckBox x:Name="UseBridgesCheckBox" Grid.Row="8" Grid.Column="1" Content="Использовать мосты" IsChecked="{Binding UseBridges}" Margin="4,8"
                          ToolTip="Что: подключаться ли к Tor через мосты. Зачем: мосты помогают установить соединение, когда прямой доступ к сети Tor блокируется. Ожидается: включено — используйте мосты при блокировке, выключено — подключайтесь напрямую. Пример: включено при блокировке доступа к сети Tor." />
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Мосты (по одному на строку)" VerticalAlignment="Top" Margin="0,8" />
                <TextBox x:Name="BridgesTextBox" Grid.Row="9" Grid.Column="1" Text="{Binding BridgesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalScrollBarVisibility="Auto" Margin="4"
                         ToolTip="Что: параметры мостов Tor. Зачем: Tor использует их как адреса и параметры мостов при включённом режиме мостов. Ожидается: тип транспорта, адрес и параметры моста, по одному на строку. Пример: obfs4 {IP}:{порт} {отпечаток} cert={сертификат} iat-mode=0." />
                <TextBlock Grid.Row="10" Grid.Column="0" Text="ClientTransportPlugin (по одному на строку)" VerticalAlignment="Top" Margin="0,8" TextWrapping="Wrap" />
                <TextBox x:Name="ClientTransportPluginsTextBox" Grid.Row="10" Grid.Column="1" Text="{Binding ClientTransportPluginsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" VerticalScrollBarVisibility="Auto" Margin="4"
                         ToolTip="Что: команда запуска программы транспортного плагина. Зачем: плагин обеспечивает работу указанного транспорта для мостов. Ожидается: транспорт, команда exec и путь к программе; по одному на строку. Пример: obfs4 exec C:\Tor\lyrebird.exe." />
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Журналы (по одному на строку)" VerticalAlignment="Top" Margin="0,8" />
                <TextBox x:Name="LogsTextBox" Grid.Row="11" Grid.Column="1" Text="{Binding LogsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" VerticalScrollBarVisibility="Auto" Margin="4"
                         ToolTip="Что: куда и с каким уровнем записывать журнал Tor. Зачем: помогает сохранять сообщения о работе Tor для диагностики и контроля. Ожидается: уровень, тип назначения и путь при файловом журнале. Пример: notice file C:\Tor\Logs\notices.log." />
                <TextBlock Grid.Row="12" Grid.Column="0" Text="Control-порты/адреса" VerticalAlignment="Center" Margin="0,4" />
                <TextBox x:Name="ControlPortsTextBox" Grid.Row="12" Grid.Column="1" Text="{Binding ControlPortsText, UpdateSourceTrigger=PropertyChanged}" Margin="4"
                         ToolTip="Что: порт управления Tor Controller. Зачем: позволяет совместимому локальному приложению отправлять команды управления Tor. Ожидается: номер порта или адрес:порт; несколько значений разделяйте запятой. Пример: 9051, 127.0.0.1:9052." />
            </Grid>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" Padding="14,6" />
            <Button x:Name="CreateButton" Content="Создать" Command="{Binding SubmitCommand}" IsDefault="True" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
