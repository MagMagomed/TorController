<Window x:Class="TorController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tor Controller" Height="820" Width="1280" MinHeight="620" MinWidth="900">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="CreateServiceButton" Content="Создать службу Tor" Command="{Binding CreateServiceCommand}" Margin="0,0,8,0" Padding="12,5" />
                <Button Content="Запустить" Command="{Binding StartCommand}" Margin="0,0,8,0" Padding="12,5" />
                <Button Content="Остановить" Command="{Binding StopCommand}" Margin="0,0,8,0" Padding="12,5" />
                <Button Content="Перезапустить" Command="{Binding RestartCommand}" Margin="0,0,8,0" Padding="12,5" />
                <Button x:Name="DeleteServiceButton" Content="Удалить службу" Command="{Binding DeleteServiceCommand}" Margin="0,0,8,0" Padding="12,5" />
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Padding="12,5" />
                <TextBlock Text="Выполняется операция со службами..." Margin="16,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </WrapPanel>
            <TextBlock x:Name="ErrorBanner" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid x:Name="ServicesGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Services}"
                  SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя службы" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Отображаемое имя" Binding="{Binding DisplayName}" />
                <DataGridTextColumn Header="Состояние" Binding="{Binding StageName}" />
                <DataGridTextColumn Header="Запуск" Binding="{Binding StartingTypeName}" />
                <DataGridTextColumn Header="SOCKS-порты" Binding="{Binding SocksPorts}" />
                <DataGridTextColumn Header="Мосты" Binding="{Binding Bridges}" Width="2*" />
                <DataGridTextColumn Header="tor.exe" Binding="{Binding TorExecutablePath}" Width="2*" />
                <DataGridTextColumn Header="torrc" Binding="{Binding ConfigurationFilePath}" Width="2*" />
                <DataGridTextColumn Header="Учётная запись" Binding="{Binding ServiceAccount}" />
            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Конфигурация выбранной службы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="SOCKS-порты/адреса" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SocksPortsText, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
                <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Использовать мосты" IsChecked="{Binding UseBridges}" VerticalAlignment="Center" Margin="8,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Мосты (по одному на строку)" VerticalAlignment="Top" Margin="0,8" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding BridgesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalScrollBarVisibility="Auto" Margin="4" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="ClientTransportPlugin" VerticalAlignment="Top" Margin="0,8" />
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ClientTransportPluginsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" VerticalScrollBarVisibility="Auto" Margin="4" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Журналы (по одному на строку)" VerticalAlignment="Top" Margin="0,8" />
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding LogsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" VerticalScrollBarVisibility="Auto" Margin="4" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Control-порты/адреса" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ControlPortsText, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="Каталог данных" VerticalAlignment="Center" Margin="8,4" />
                <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding DataDirectoryText, UpdateSourceTrigger=PropertyChanged}" Margin="4" />

                <Button x:Name="SaveConfigurationButton"
                        Grid.Row="6"
                        Grid.Column="3"
                        Content="Проверить и сохранить"
                        Command="{Binding SaveConfigurationCommand}"
                        HorizontalAlignment="Right"
                        Margin="4,10,4,0"
                        Padding="14,6" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
